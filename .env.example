# SK Store — environment variable reference
# Copy values into application-specific env files. Do not commit secrets.

# --- server/.env ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skstore?schema=public
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Auth (Phase 4)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_MS=60000

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:3001
