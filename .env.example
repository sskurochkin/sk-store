# SK Store — environment variable reference
# Copy values into application-specific env files. Do not commit secrets.

# --- server/.env ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skstore?schema=public
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Auth (Phase 4)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_MS=60000

# Email / SMTP (Phase 9)
# Leave SMTP_HOST empty in local/dev to use Nodemailer jsonTransport (no network).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=noreply@localhost
ORDER_NOTIFICATION_EMAIL=orders@localhost

# --- frontend/.env.local ---
# NestJS origin used by Next.js rewrites (`/api/*` → Nest) and server-side fetches.
# Browser code must call same-origin `/api/...` (not this URL directly).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public site origin for metadataBase, Open Graph, and canonical URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated image hostnames for next/image (in addition to example.com).
# Hostname only — no wildcards or paths. Example: images.cdn.example,cdn.example.com
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=
