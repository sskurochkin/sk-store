# SK Store — environment variable reference
# Copy values into application-specific env files. Do not commit secrets.

# --- server/.env ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:123456@localhost:5432/skstore?schema=public
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:3001
