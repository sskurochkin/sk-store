generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  alias       String      @unique
  description String      @db.Text
  mainPhoto   String
  gallery     String[]    @default([])
  price       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([createdAt])
}

model News {
  id          String   @id @default(cuid())
  title       String
  alias       String   @unique
  description String   @db.Text
  mainPhoto   String
  content     String   @db.Text
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model Order {
  id         String      @id
  firstName  String
  lastName   String
  userEmail  String
  userPhone  String
  comment    String?     @db.Text
  totalPrice Decimal     @db.Decimal(12, 2)
  status     OrderStatus @default(NEW)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userEmail])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Social {
  id   String @id @default(cuid())
  name String
  link String
  icon String
}

model SiteSettings {
  id          String @id @default("default")

  siteName    String
  tagline     String?
  description String @db.Text
  footerBlurb String? @db.Text
  logoUrl     String?

  phone        String?
  email        String?
  address      String? @db.Text
  workingHours String? @db.Text

  mapEnabled  Boolean @default(false)
  mapEmbedUrl String?
  mapLinkUrl  String?

  legalOperatorName String?
  legalContactEmail String?

  seoMetaDescription String? @db.Text
  seoKeywords        String? @db.Text
  seoRobotsIndex     Boolean @default(true)
  seoRobotsFollow    Boolean @default(true)
  seoOgTitle         String?
  seoOgDescription   String? @db.Text
  seoOgImageUrl      String?
  googleAnalyticsId  String?
  yandexMetrikaId    String?

  updatedAt DateTime @updatedAt
}

model HomeBenefit {
  id          String @id @default(cuid())
  title       String
  description String @db.Text
  icon        String
  sortOrder   Int    @default(0)
}

model LegalPage {
  slug      String @unique
  title     String
  sections  Json
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String               @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  message   String               @db.Text
  consent   Boolean
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}
