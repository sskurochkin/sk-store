# SK Store server — copy to `.env` and fill in local values.
# Do not commit secrets.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skstore?schema=public
# Required in production (exact frontend origin). In development, empty reflects request Origin.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_MS=60000
# Public write throttle (POST /orders, POST /contact-requests)
PUBLIC_WRITE_RATE_LIMIT=5
PUBLIC_WRITE_RATE_TTL_MS=60000

# Email / SMTP — leave SMTP_HOST empty for local jsonTransport (no network)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=noreply@localhost
ORDER_NOTIFICATION_EMAIL=orders@localhost
