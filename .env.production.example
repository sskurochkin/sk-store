# SK Store — production Docker environment (server-side only)
# Copy to `.env.production` on the deployment host. Never commit real values.
#
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production

# --- PostgreSQL (Docker service: postgres) ---
POSTGRES_DB=skstore
POSTGRES_USER=skstore_app
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Public site (build-time for frontend image + runtime CORS) ---
# Must match the public HTTPS origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_DOMAIN

# Host port published for frontend (reverse proxy targets this).
FRONTEND_PUBLISH_PORT=3000

# --- Backend auth / cookies ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# --- Rate limiting ---
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_MS=60000
PUBLIC_WRITE_RATE_LIMIT=5
PUBLIC_WRITE_RATE_TTL_MS=60000

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=noreply@YOUR_DOMAIN
ORDER_NOTIFICATION_EMAIL=orders@YOUR_DOMAIN

# --- Optional frontend build args ---
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=cdn.example.com
