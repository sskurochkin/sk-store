# SK Store — production Docker environment
# Copy to `.env.production` on the server ONLY. Never commit real values.
#
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production ...

# --- PostgreSQL (Docker service: postgres) ---
POSTGRES_DB=skstore
POSTGRES_USER=skstore_app
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Public site (build-time + runtime CORS) ---
# Must match the public HTTPS origin exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_DOMAIN

# Frontend bind on host localhost (Nginx proxies here). Do not expose publicly.
FRONTEND_PUBLISH_PORT=3000

# --- Admin bootstrap (production seed only — never commit real password) ---
# Required when running: node dist/prisma/seed.js
# Minimum 12 characters. Must NOT be admin123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password-min-12-chars

# --- Backend auth / cookies ---
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
# Requires HTTPS via Nginx before public launch
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# --- Rate limiting ---
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_MS=60000
PUBLIC_WRITE_RATE_LIMIT=5
PUBLIC_WRITE_RATE_TTL_MS=60000

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
# Generate/store securely if your provider requires authentication
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=noreply@YOUR_DOMAIN
ORDER_NOTIFICATION_EMAIL=orders@YOUR_DOMAIN

# --- Optional frontend build args ---
# Comma-separated hostnames for next/image (your CDN or image host)
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=cdn.example.com

# --- Internal (set automatically in docker-compose.prod.yml build) ---
# API_INTERNAL_URL=http://backend:3001  — do not set on host; used in frontend Docker build
